	(text "[Nicolas Robin] This section\nhas been corrected to match the\nconnections as found on the real PCB."
		(exclude_from_sim no)
		(at 228.6 332.74 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "2c0221d8-40c9-4dbb-a019-5dcabe169785")
	)
	(text "UNIT, AS SUPPLIED, INCLUDES A 6502\nMICROPROCESSOR, AND SOLDER JUMPERS\nAT BOTH POINTS MARKED \"6502\", AND HAS\nOMITTED ALL COMPONENTS SHOWN WITHIN\nTHE DOTTED BOX. IF A 6800 IS SUBSTITUTED\nFOR THE 6502 IT IS NECESSARY TO INSTALL\nALL COMPONENTS SHOWN, AND TO BREAK\nBOTH SOLDER BRIDGES NOTED \"6502\"."
		(exclude_from_sim no)
		(at 226.06 358.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "35a790ec-7664-4a7d-afa9-0834267ccbf1")
	)
	(text "DSP"
		(exclude_from_sim no)
		(at 151.13 297.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3a497088-1ccc-4190-90d9-336b7b77de7d")
	)
	(text "KYBD"
		(exclude_from_sim no)
		(at 146.685 264.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "64a0365c-38cf-495e-aae2-9510d1d69137")
	)
	(text "KYBD & DSP ARE INTERRUPT OUTPUTS FROM PIA.\nPOINTS LABELED \"IRQ\", \"NMI\" ARE INTERRUPT\nINPUTS FROM MICROPROCESSOR.\nFOR NORMAL OPERATION NO JUMPERS ARE REQUIRED."
		(exclude_from_sim no)
		(at 158.75 275.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "672fe781-4a13-49ac-be73-4c7a7f97844e")
	)
	(text "NOTES: (continued from sheet 1/3)\n\n7.	UNIT, AS SUPPLIED, IN-\n	CLUDES A 6502 MICRO-\n	PROCESSOR, AND SOLDER\n	JUMPERS AT BOTH POINTS\n	MARKED \"6502\", AND HAS\n	OMITTED ALL COMPON-\n	ENTS SHOWN WITHIN THE\n	DOTTED BOX. IF A 6800\n	IS SUBSTITUTED FOR THE\n	6502 IT IS NECESSARY TO\n	INSTALL ALL COMPON-\n	ENTS SHOWN, AND TO\n	BREAK BOTH SOLDER\n	BRIDGES NOTED \"6502\".\n\n8.	UNIT IS SUPPLIED WITH :\n		Y JUMPERED TO CSF\n		Z JUMPERED TO CSD\n		W JUMPERED TO CS1\n		X JUMPERED TO CS0\n\n	R, S AND T ARE USER\n	SELECTABLE CHIP\n	SELECTS. (4K BLOCKS)"
		(exclude_from_sim no)
		(at 505.46 263.652 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6f87e5f9-831f-4e94-80e0-a5d3a34db433")
	)
	(text "(6800 ONLY)"
		(exclude_from_sim no)
		(at 269.24 337.82 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify right bottom)
		)
		(uuid "cf02a40a-47fe-4314-a5ee-ca868823afef")
	)
	(text "IF DMA REQUIRED, BREAK JUMPER NOTED \"NO DMA\".\nUSE 74S257 AT POSITIONS B5, B6,\nB7 ANS D8. (AS SUPPLIED)"
		(exclude_from_sim no)
		(at 487.045 293.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d10f4d36-01d6-46c0-9cdd-cfc42d48d7c3")
	)
	(text "B4-1 : N.O. SWITCH TO GND\nB4-12: N.O. SWITCH TO +5V\nB4-14: STROBE\nB4-15: SHOULD BE JUMPERED\n TO VCC (+5V) FOR NORMAL\n OPERATION WITH SUPPLIED SOFTWARE"
		(exclude_from_sim no)
		(at 187.96 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e1940357-054e-4d53-9211-f1fd7a8ecc5a")
	)
